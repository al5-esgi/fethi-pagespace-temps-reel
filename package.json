{
  "name": "editeur-collaboratif",
  "private": true,
  "type": "module",
  "description": "Editeur de documents collaboratif - template de projet temps reel",
  "scripts": {
    "predev": "npm run build:client",
    "dev": "tsx watch src/server.ts",
    "prestart": "npm run build:client",
    "start": "tsx src/server.ts",
    "build:client": "node scripts/build-client.mjs",
    "seed": "tsx src/seed.ts --print",
    "scenario": "tsx src/realtime/piege.scenario.ts",
    "s3:token": "tsx src/realtime/make-token.ts",
    "test:tp5": "tsx src/realtime/s5.scenario.ts",
    "test:tp6": "tsx src/realtime/s6.scenario.ts",
    "test:tp7": "tsx src/realtime/s7.scenario.ts",
    "s7:load": "tsx src/realtime/s7.load.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:client && node scripts/build-server.mjs",
    "setup:demo": "node scripts/setup-demo.mjs",
    "test:security": "tsx --test tests/security.test.ts && node --test tests/gates.test.mjs",
    "security:gate": "node scripts/security/gate.mjs",
    "security:regression": "node scripts/security/regression.mjs"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.5",
    "@socket.io/redis-adapter": "^8.3.0",
    "fastify": "5.12.5",
    "jsonwebtoken": "^9.0.2",
    "prom-client": "^15.1.3",
    "redis": "^4.7.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "esbuild": "0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "version": "1.0.0"
}
